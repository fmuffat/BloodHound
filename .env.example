# ── Ruckus One API ────────────────────────────────────────────────────────────
# Get these from the Ruckus One portal > API Credentials.
# Note: these are only used as bootstrap defaults on first boot — once
# configured via Settings → Ruckus One in the UI, the live values are
# stored in Redis and take effect immediately, no restart needed.
RUCKUS_ONE_REGION=EU
RUCKUS_ONE_TENANT_ID=your_tenant_id_here
RUCKUS_ONE_CLIENT_ID=your_client_id_here
RUCKUS_ONE_CLIENT_SECRET=your_client_secret_here

# ── Unleashed ─────────────────────────────────────────────────────────────────
# Same note as above — bootstrap defaults only, live config goes through
# Settings → Unleashed in the UI.
UNLEASHED_IP=
UNLEASHED_USERNAME=admin
UNLEASHED_PASSWORD=
UNLEASHED_ENABLED=false

# ── Graylog (internal service account, not customer-specific) ────────────────
GRAYLOG_USER=admin
GRAYLOG_PASSWORD=admin
