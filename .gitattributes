# Auto detect text files and perform LF normalization
* text=auto

# Files executed on the Linux appliance must keep LF even on a Windows checkout
*.sh       text eol=lf
*.py       text eol=lf
*.service  text eol=lf
*.path     text eol=lf
*.conf     text eol=lf
*.yml      text eol=lf
Dockerfile text eol=lf
*.rule     text eol=lf
*.yaml     text eol=lf
appliance/files/** text eol=lf
