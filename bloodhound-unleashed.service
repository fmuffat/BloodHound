[Unit]
Description=Bloodhound — Unleashed Sync Worker
After=network.target docker.service
Requires=docker.service

[Service]
User=fmuffat
WorkingDirectory=/home/fmuffat/syslog-platform
Environment="UNLEASHED_IP=192.168.1.130"
Environment="UNLEASHED_USERNAME=admin"
Environment="UNLEASHED_PASSWORD=Password74!"
Environment="REDIS_URL=redis://127.0.0.1:6379"
Environment="UNLEASHED_SYNC_INTERVAL=300"
ExecStart=/usr/bin/python3 /home/fmuffat/syslog-platform/unleashed_worker.py --daemon
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
